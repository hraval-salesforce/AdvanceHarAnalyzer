# Environment configuration template
# Copy this file to .env for local development

# Application Environment (local, staging, production)
ENVIRONMENT=local

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Security - JWT Secret Key (REQUIRED)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-this-in-production

# Database Configuration
# For local development, leave blank to use SQLite (auto-created)
# For production, Heroku sets this automatically when you add PostgreSQL addon
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Legacy AI - Gemini API Key (optional, for backward compatibility)
GEMINI_API_KEY=

# Claude API Keys are managed via admin panel (/admin)
# No need to set CLAUDE_API_KEY here

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Gunicorn Workers (for Heroku)
WEB_CONCURRENCY=2

# Debug Mode (true for local, false for staging/production)
DEBUG=true

# Application URL (used for CORS and redirects)
APP_URL=http://localhost:8000
