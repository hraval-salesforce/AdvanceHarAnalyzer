# Gemini HAR Analyzer - Environment Configuration Template
# Copy this file to .env and fill in your actual values
#
# IMPORTANT:
# - DO NOT commit .env files to git
# - Keep your API keys secret
# - Use different keys for development and production

# =============================================================================
# GEMINI API CONFIGURATION (REQUIRED)
# =============================================================================
# Get your API key from: https://makersuite.google.com/app/apikey
# Example format: AIzaSyBx1234567890abcdefghijklmnopqrst
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Port for the backend server (default: 8000)
PORT=8000

# Host binding (0.0.0.0 allows external connections, 127.0.0.1 is localhost only)
HOST=0.0.0.0

# =============================================================================
# GUNICORN WORKER CONFIGURATION
# =============================================================================
# Number of worker processes (default: 2)
# For production, use: (2 * CPU_CORES) + 1
WEB_CONCURRENCY=2

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allowed origins for CORS (comma-separated list)
# For development: Use *
# For production: Use your actual domain(s)
# Examples:
#   Development: ALLOWED_ORIGINS=*
#   Production: ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=*

# =============================================================================
# ENVIRONMENT
# =============================================================================
# Environment name (development, staging, production)
ENVIRONMENT=development

# =============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# SECURITY CONFIGURATION (OPTIONAL)
# =============================================================================
# Enable HTTPS redirect (true/false)
# FORCE_HTTPS=false

# API rate limit (requests per minute per IP)
# RATE_LIMIT=60

# Maximum request size in bytes (default: 10MB)
# MAX_REQUEST_SIZE=10485760
